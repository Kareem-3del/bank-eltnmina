  << /K [ 840 0 R ]
     /P 854 0 R
     /S /P
     /Pg 802 0 R
     /Type /StructElem
  >>
endobj

842 0 obj
  << /ActualText (Looking ahead into 2026\054 REDF\031s potential for success will increasingly depend on product and policy innovation\054 delivered on a strong foundation of financial sustainability\072 Key priorities for the coming year include\072)
     /K [ 20 ]
     /P 843 0 R
     /Pg 802 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

